# --- required, build-time (baked into Docker image) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- required, runtime ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app_dev
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- optional, runtime ---
# Google OAuth — both must be set for the provider to be enabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Remaining optional integrations (Redis, RabbitMQ, S3, Resend) are added
# here as their own milestones wire them up — see SPEC.md section 3 for the
# full planned list.
