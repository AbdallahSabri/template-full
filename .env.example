# --- required, build-time (baked into Docker image) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- required, runtime ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app_dev
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- optional, runtime ---
# Google OAuth — both must be set for the provider to be enabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# S3-compatible storage. S3_BUCKET gates the feature — the rest are
# meaningless without it. For local dev against the `storage` compose
# profile: AWS_ACCESS_KEY_ID=minioadmin, AWS_SECRET_ACCESS_KEY=minioadmin,
# S3_BUCKET=app-dev, S3_REGION=us-east-1, S3_ENDPOINT=http://localhost:9000.
# Omit S3_ENDPOINT for AWS S3 in prod.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=

# Resend. Both must be set together — EMAIL_FROM alone can't send, and
# RESEND_API_KEY alone has no from address. Falls back to a console.log
# of the email when unset.
RESEND_API_KEY=
EMAIL_FROM=

# Redis. Gates both caching (cache.ts) and the Redis-backed sliding-window
# rate limiter (rate-limit.ts) — unset falls back to no-op cache and an
# in-memory (per-instance, non-durable) rate limiter. For local dev:
# redis://localhost:6379 against the `redis` compose profile.
REDIS_URL=

# RabbitMQ. Gates publish() — unset runs the inline handler synchronously
# in-process instead of publishing a message. For local dev:
# amqp://guest:guest@localhost:5672 against the `queue` compose profile.
RABBITMQ_URL=
