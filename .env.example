# --- required, build-time (baked into Docker image) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- required, runtime ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app_dev
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- optional, runtime ---
# Google OAuth — both must be set for the provider to be enabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# S3-compatible storage. S3_BUCKET gates the feature — the rest are
# meaningless without it. For local dev against the `storage` compose
# profile: AWS_ACCESS_KEY_ID=minioadmin, AWS_SECRET_ACCESS_KEY=minioadmin,
# S3_BUCKET=app-dev, S3_REGION=us-east-1, S3_ENDPOINT=http://localhost:9000.
# Omit S3_ENDPOINT for AWS S3 in prod.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=

# Remaining optional integrations (Redis, RabbitMQ, Resend) are added here
# as their own milestones wire them up — see SPEC.md section 3 for the
# full planned list.
