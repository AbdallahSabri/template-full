{
  "permissions": {
    "allow": [
      "Bash(bash scripts/check.sh *)",
      "Bash(grep *)",
      "Bash(cat *)",
      "Bash(cd *)",
      "Bash(source *)",
      "Bash(npm run *)"
    ],
    "additionalDirectories": ["~/.nvm"],
    "defaultMode": "bypassPermissions"
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "filesystem": {
      "allowWrite": ["."]
    },
    "network": {
      "allowLocalBinding": true
    }
  }
}
