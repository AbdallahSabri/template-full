{
  "permissions": {
    "allow": [
      "Bash(bash scripts/check.sh *)",
      "Bash(grep *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(tail *)",
      "Bash(build *)",
      "Bash(export *)",
      "Bash(python3 *)",
      "Bash(pkill *)",
      "Bash(sleep *)",
      "Bash(date *)",
      "Bash(lsof *)",
      "Bash(sod *)",
      "Bash(sed *)",
      "Bash(cd *)",
      "Bash(docker *)",
      "Bash(node *)",
      "Bash(echo *)",
      "Bash(cp *)",
      "Bash(source *)",
      "Bash(npm run *)",
      "Bash(pnpm run *)",
      "Bash(find run *)",
      "Bash(git commit *)",
      "Bash(git add *)",
      "Bash(git log *)",
      "Bash(git push)",
      "Bash(git status *)",
      "Bash(git push *)"
    ],
    "additionalDirectories": ["~/.nvm"],
    "defaultMode": "bypassPermissions"
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "filesystem": {
      "allowWrite": ["."]
    },
    "network": {
      "allowLocalBinding": true
    }
  }
}
